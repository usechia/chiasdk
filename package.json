{
  "name": "chia",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:beta": "changeset pre enter beta && pnpm version-packages && changeset pre exit",
    "release:major": "changeset major",
    "release:minor": "changeset minor",
    "release:patch": "changeset patch",
    "version:beta": "changeset version --snapshot beta",
    "publish:beta": "pnpm build && changeset publish --tag beta",
    "publish:release": "pnpm build && changeset publish --tag latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@changesets/cli": "^2.30.0",
    "conventional-changelog-cli": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@conventional-changelog/git-client": ">=2.0.0",
      "axios": "^1.18.1",
      "form-data": "^4.0.6",
      "glob": ">=11.0.0",
      "qs": "^6.15.2",
      "js-yaml": "^3.15.0",
      "diff": ">=7.0.0",
      "tmp": ">=0.2.3",
      "on-headers": ">=1.0.3",
      "brace-expansion": "^5.0.6",
      "@modelcontextprotocol/sdk": ">=1.0.7",
      "lodash": ">=4.18.0",
      "hono": "^4.12.30",
      "@hono/node-server": ">=2.0.5",
      "express-rate-limit": ">=8.2.2",
      "serialize-javascript": ">=7.0.5",
      "svgo": ">=4.0.2",
      "handlebars": ">=4.7.9",
      "minimatch": ">=10.2.3",
      "picomatch": ">=2.3.2",
      "shell-quote": "^1.10.0",
      "ws": "^8.21.1",
      "fast-uri": "^3.1.4",
      "postcss": ">=8.5.18",
      "@babel/core": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "webpack-dev-server": "^5.2.5",
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.3.0",
      "http-proxy-middleware": "^2.0.10",
      "launch-editor": "^2.14.1",
      "ip-address": "^10.1.1",
      "joi": "^17.13.4",
      "uuid": "^11.1.1",
      "esbuild": "^0.28.1",
      "follow-redirects": "^1.16.0",
      "websocket-driver": ">=0.7.5"
    }
  }
}