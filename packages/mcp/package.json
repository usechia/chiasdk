{
  "name": "@chiahq/mcp",
  "version": "0.0.4",
  "description": "Model Context Protocol server for Chia SDK - enabling AI assistants to interact with African payment providers (PayChangu & PawaPay)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "chia-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chia",
    "paychangu",
    "pawapay",
    "onekhusa",
    "payment",
    "africa",
    "mobile-money",
    "disbursement",
    "collection",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@chiahq/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usechia/chiasdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/usechia/chiasdk/issues"
  },
  "homepage": "https://github.com/usechia/chiasdk/tree/master/packages/mcp#readme",
