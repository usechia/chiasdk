# PayChangu Configuration
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key
PAYCHANGU_RETURN_URL=https://your-return-url.com
PAYCHANGU_ENVIRONMENT=DEVELOPMENT # or PRODUCTION

# PawaPay Configuration
PAWAPAY_JWT=your_pawapay_jwt_token
PAWAPAY_ENVIRONMENT=DEVELOPMENT # or PRODUCTION

# General Configuration
NODE_ENV=development # or production 

# Chia Platform (unified routing + platform services)
# Required for the SDK's automatic provider routing (sdk.payments.initiate
# without a pinned provider). Direct provider access does not need it.
CHIA_API_KEY=your_chia_api_key
# CHIA_API_BASE_URL=https://api.usechia.com
